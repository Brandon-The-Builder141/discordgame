DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: deploy slash commands to one test server for instant updates.
# Leave blank to deploy globally, which can take longer to appear.
DISCORD_GUILD_ID=your_test_server_id_here
MESSAGE_CONTENT_INTENT=false
DAVE_ENCRYPTION=true
VOICE_TRANSCRIPTION_ENABLED=true

# Optional: override the local save path.
SAVE_FILE=./data/save.json

# Optional: enables AI-enriched narration. Use openrouter/free for free-model routing.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_STT_MODEL=openai/whisper-1
